server {
    include /etc/nginx/common/server_common.conf;
    server_name ampd.{{ external_hostname }};

    location / {
        set $upstream http://ampd:8080;
        proxy_pass $upstream;
        include /etc/nginx/common/proxy_common.conf;
        include /etc/nginx/common/internal_only.conf;
    }
}

server {
    include /etc/nginx/common/server_common.conf;
    server_name snapcast.{{ external_hostname }};

    location / {
        set $upstream http://snapcast:1780;
        proxy_pass $upstream;
        include /etc/nginx/common/proxy_common.conf;
        include /etc/nginx/common/internal_only.conf;
    }
}
