# Gatus configuration - dynamically generated by Ansible
# Generated on: {{ ansible_date_time.iso8601 }}

storage:
  type: sqlite
  path: /data/data.db

web:
  port: 8080

endpoints:
{% for endpoint in all_monitored_endpoints | default([]) %}
  - name: "{{ endpoint.name }}"
    url: "{{ endpoint.url }}"
{% if endpoint.method is defined %}
    method: {{ endpoint.method }}
{% endif %}
    interval: "{{ endpoint.interval }}"
    group: "{{ endpoint.group }}"
    conditions:
{% for condition in endpoint.conditions | default(["[STATUS] == any(200, 204)"]) %}
      - "{{ condition }}"
{% endfor %}

{% endfor %}

external-endpoints:
{% for endpoint in all_push_monitors | default([]) %}
  - name: "{{ endpoint.name }}"
    group: "{{ endpoint.group }}"
    token: "{{ push_monitor_token }}"
    heartbeat:
      interval: "{{ endpoint.interval }}"
{% endfor %}
