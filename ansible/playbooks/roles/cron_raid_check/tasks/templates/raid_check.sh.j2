#!/bin/bash

set -euo pipefail

# Redirect all output to both log file and console
exec > >(tee -a {{ log_path }}) 2>&1

info() { printf "\n%s %s\n\n" "$( date )" "$*" >&2; }
trap 'echo $( date ) RAID array health check interrupted >&2; exit 2' INT TERM

ARRAY="/dev/md0"
STATUS="ok"
MESSAGE="RAID healthy"

info "Starting RAID array health check"

DETAIL="$(mdadm --detail "$ARRAY")"

if echo "$DETAIL" | grep -qE 'State :.*(degraded|recovering|resyncing|failed)'; then
  STATUS="error"
  MESSAGE="RAID state not clean"
elif ! echo "$DETAIL" | grep -q 'Active Devices : 2'; then
  STATUS="error"
  MESSAGE="Active devices != 2"
elif ! echo "$DETAIL" | grep -q 'Working Devices : 2'; then
  STATUS="error"
  MESSAGE="Working devices != 2"
fi

info "RAID check result: $MESSAGE"

if [ "$STATUS" == "error" ]; then
    SUCCESS="false"
    ERROR_PARAM="&error=$MESSAGE"
else
    SUCCESS="true"
    ERROR_PARAM=""
fi

{% for host in push_monitor_hosts %}
curl -fsS -X POST -H "Authorization: Bearer {{ token }}" "https://{{ host }}/api/v1/endpoints/{{ monitor_key }}/external?success=$SUCCESS$ERROR_PARAM" || \
    info "Warning: Could not reach start monitor at {{ host }}"
{% endfor %}
