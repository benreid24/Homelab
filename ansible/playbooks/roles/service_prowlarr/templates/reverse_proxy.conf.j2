server {
    include /etc/nginx/common/server_common.conf;
    server_name prowlarr.{{ external_hostname }};

    location / {
        set $upstream http://gluetun:9696;
        proxy_pass $upstream;
        include /etc/nginx/common/proxy_common.conf;
        include /etc/nginx/common/internal_only.conf;
    }
}

server {
    include /etc/nginx/common/server_common.conf;
    server_name flaresolverr.{{ external_hostname }};

    location / {
        set $upstream http://gluetun:8191;
        proxy_pass $upstream;
        include /etc/nginx/common/proxy_common.conf;
        include /etc/nginx/common/internal_only.conf;
    }
}
