server {
    include /etc/nginx/common/server_common.conf;
    server_name msync.{{ external_hostname }};

    location / {
        set $upstream http://msync:3000;
        proxy_pass $upstream;
        include /etc/nginx/common/proxy_common.conf;
        include /etc/nginx/common/internal_only.conf;
    }
}

server {
    include /etc/nginx/common/server_common.conf;
    server_name syncthing-music.{{ external_hostname }};

    location / {
        set $upstream http://msync-syncthing:8384;
        proxy_pass $upstream;
        include /etc/nginx/common/proxy_common.conf;
        include /etc/nginx/common/internal_only.conf;
    }
}
