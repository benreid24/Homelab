---
# For configuration options and examples, please see:
# https://gethomepage.dev/configs/services/

- Infrastructure:
  - Omada:
      href: https://omada.{{ external_hostname }}/
      icon: https://omada.{{ external_hostname }}/favicon.ico?v=2
      description: Network control plane
      server: docker-socket
      container: omada-controller
  - Nginx:
      icon: /icons/nginx.png
      description: Reverse proxy and web server
      server: docker-socket
      container: nginx
  - AdGuard Primary:
      href: https://dns.{{ external_hostname }}
      icon: https://dns.{{ external_hostname }}/assets/favicon.png
      description: Private DNS
      server: docker-socket
      container: adguard
      statusStyle: dot
      showStats: false
      widget:
        type: adguard
        url: https://dns.{{ external_hostname }}
        username: admin
        password: {{ adguard_password }}
        fields:
          - queries
          - blocked
          - latency
  - AdGuard Secondary:
      href: http://{{ onsite_pi_ip }}
      icon: https://dns.{{ external_hostname }}/assets/favicon.png
      description: Private DNS
      server: docker-socket
      siteMonitor: http://{{ onsite_pi_ip }}
      widget:
        type: adguard
        url: http://{{ onsite_pi_ip }}
        username: admin
        password: {{ adguard_password }}
        fields:
          - queries
          - blocked
          - latency
  - Dynamic DNS:
      href: https://dash.cloudflare.com/
      icon: https://dash.cloudflare.com/favicon.ico
      description: Automatic DNS update service
      server: docker-socket
      container: ddns
  - Komodo:
      href: https://komo.{{ external_hostname }}/stacks
      icon: /icons/komodo.png
      description: Running container stats and control
      server: docker-socket
      container: komodo
      showStats: false
      widget:
        type: komodo
        url: https://komo.{{ external_hostname }}
        key: {{ komodo_api_key }}
        secret: {{ komodo_api_secret }}
        showSummary: true

- Services:
  - Home Assistant:
      href: https://ha.{{ external_hostname }}
      icon: https://ha.{{ external_hostname }}/static/icons/favicon.ico
      description: Home automation and control
      server: docker-socket
      container: homeassistant
  - Immich:
      href: https://immich.{{ external_hostname }}
      icon: https://immich.{{ external_hostname }}/favicon.ico
      description: Photo organization and gallery
      server: docker-socket
      container: immich_server
  - Seafile:
      href: https://seafile.{{ external_hostname }}
      icon: https://seafile.{{ external_hostname }}/media/favicons/favicon.png
      description: File synchronization and backup
      server: docker-socket
      container: seafile
  - Mealie:
      href: https://mealie.{{ external_hostname }}
      icon: https://mealie.{{ external_hostname }}/favicon.ico
      description: Recipe storage and meal planner
      server: docker-socket
      container: mealie
  - Satisfactory:
      icon: /icons/satisfactory.png
      description: Satisfactory game server
      widget:
        type: customapi
        url: https://{{ host_ip }}:7777/api/v1
        method: POST
        headers:
          Content-Type: application/json
        requestBody:
          function: HealthCheck
          data:
            ClientCustomData: {}
        mappings:
          - field: data.health
            label: Status
            format: text
  - NVR:
      href: https://192.168.0.10/
      icon: https://192.168.0.10/favicon.ico
      description: Camera feeds and recordings
      siteMonitor: https://192.168.0.10/
      widget:
        type: homeassistant
        url: https://ha.{{ external_hostname }}
        key: {{ homepage_ha_token }}
        custom:
          - template: "{% raw %}{{ states('switch.nvr_record') }}{% endraw %}"
            label: Recording
          - template: "{% raw %}{{ 'Up to Date' if state_attr('update.nvr_firmware', 'installed_version') == state_attr('update.nvr_firmware', 'latest_version') else 'Out of Date' }}{% endraw %}"
            label: Firmware

- AudioContainer:
  - Home Audio:
    - Playback Control:
        href: https://ampd.{{ external_hostname }}/browse
        icon: mdi-music-circle-#7b19bd
        description: Control plane for music playback
        server: docker-socket
        container: ampd
    - Snapcast:
        href: https://snapcast.{{ external_hostname }}
        icon: /icons/snapcast.png
        description: Audio zone management
        server: docker-socket
        container: snapcast
    - Librespot:
        description: Spotify Connect adaptor service
        icon: /icons/spotify.png
        server: docker-socket
        container: librespot
    - Music Player Daemon:
        description: API service for audio playback control
        icon: /icons/mpd.png
        server: docker-socket
        container: mpd

  - Zones:
    - Downstairs Zones:
      - Fireplace Zone:
          href: http://192.168.0.200/
          icon: mdi-cast-audio-#5191e0
          description: Audio zone in the game room
          siteMonitor: http://192.168.0.200/
      - Dining Room Zone:
          href: http://192.168.0.202/
          icon: mdi-cast-audio-#5191e0
          description: Audio zone in the dining room
          siteMonitor: http://192.168.0.202/
      - TV Room Zone:
          href: http://192.168.0.202/
          icon: mdi-cast-audio-#5191e0
          description: Audio zone in the TV room
          siteMonitor: http://192.168.0.202/
    - Upstairs Zones:
      - Office Zone:
          href: http://192.168.0.205/
          icon: mdi-cast-audio-#5191e0
          description: Audio zone in the upstairs office
          siteMonitor: http://192.168.0.205/
      - Bedroom Zone:
          href: http://192.168.0.204/
          icon: mdi-cast-audio-#5191e0
          description: Audio zone in the bedroom
          siteMonitor: http://192.168.0.204/
      - Bathroom Zone:
          href: http://192.168.0.203/
          icon: mdi-cast-audio-#5191e0
          description: Audio zone in the upstairs bathroom
          siteMonitor: http://192.168.0.203/

  - Music Sync:
    - mSync:
        href: https://msync.{{ external_hostname }}
        icon: https://msync.{{ external_hostname }}/assets/favicon.png
        description: Youtube playlist auto sync
        server: docker-socket
        container: msync
    - mSync Seafile:
        href: https://seafile.{{ external_hostname }}/library/{{ seafile_music_library_id }}
        icon: https://seafile.{{ external_hostname }}/media/favicons/favicon.png
        description: Seafile client instance for music sync
        server: docker-socket
        container: seafile-client
    - mSync Syncthing:
        href: https://syncthing-music.{{ external_hostname }}
        icon: https://syncthing-music.{{ external_hostname }}/assets/img/favicon-default.png
        description: Syncthing client for music folder sync
        server: docker-socket
        container: msync-syncthing
    - Redbot:
        description: Discord bot for music
        server: docker-socket
        container: redbot
        icon: mdi-robot-#cc2316

- BottomRow:
  - BackupsRow:
    - Backups:
      - Onsite:
          description: Onsite backup status
          href: https://kuma.{{ external_hostname }}/status/backup-onsite
          icon: mdi-harddisk-#0c929c
          widget:
            type: uptimekuma
            url: https://kuma.{{ external_hostname }}
            slug: backup-onsite
    - " ":
      - Offsite:
          description: Offsite backup status
          href: https://kuma.{{ external_hostname }}/status/backup-offsite
          icon: mdi-harddisk-#0c4f9c
          widget:
            type: uptimekuma
            url: https://kuma.{{ external_hostname }}
            slug: backup-offsite
    - Energy:
      - Power Usage:
          href: https://ha.{{ external_hostname }}/dashboard-power/0
          description: Current power consumption
          icon: mdi-lightning-bolt-circle-#bfc930
          widget:
            type: homeassistant
            url: https://ha.{{ external_hostname }}
            key: {{ homepage_ha_token }}
            custom:
              - template: "{% raw %}{{ states('sensor.emporiavue2_total_power') | float(0) | round(0) }} W{% endraw %}"
                label: Active Draw
              - template: "{% raw %}{{ (states('sensor.emporiavue2_total_daily_energy') | float(0) / float(1000)) | round(1) }} KWh{% endraw %}"
                label: Used Today
  - Monitoring:
    - Services:
        href: https://kuma.{{ external_hostname }}
        icon: https://kuma.{{ external_hostname }}/favicon.ico
        description: Uptime for all services
        server: docker-socket
        container: uptime-kuma
        showStats: false
        widget:
          type: uptimekuma
          url: https://kuma.{{ external_hostname }}
          slug: services
    - Kuma Primary:
        href: https://kuma.{{ external_hostname }}
        icon: https://kuma.{{ external_hostname }}/favicon.ico
        description: Service monitoring and alarms
        server: docker-socket
        container: uptime-kuma
        showStats: false
        widget:
          type: uptimekuma
          url: http://{{ onsite_pi_ip }}:3001/
          slug: kuma-primary
    - Kuma Secondary:
        href: http://{{ onsite_pi_ip }}:3001/
        icon: https://kuma.{{ external_hostname }}/favicon.ico
        description: Service monitoring and alarms
        siteMonitor: http://{{ onsite_pi_ip }}:3001/
        widget:
          type: uptimekuma
          url: https://kuma.{{ external_hostname }}
          slug: kuma-secondary
