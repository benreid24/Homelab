scrape_configs:
  - job_name: 'node_exporter'
    scrape_interval: 5s
    static_configs:
      - targets:
        - "{{ overseer_ip }}:9100"
        - "{{ onsite_pi_ip }}:9100"
        - "{{ offsite_pi_ip }}:9100"

  - job_name: 'gpu_exporter'
    scrape_interval: 5s
    static_configs:
      - targets:
        - "gpu-prom.{{ overseer_hostname }}"

  - job_name: 'cadvisor'
    scrape_interval: 5s
    static_configs:
      - targets:
        - "cadvisor.{{ overseer_hostname }}"
        - "cadvisor.{{ onsite_pi_hostname }}"
        - "cadvisor.{{ offsite_pi_hostname }}"

  - job_name: 'satisfactory_prometheus'
    scrape_interval: 5s
    static_configs:
      - targets: ['satisfactory-prometheus:9777']

  - job_name: 'immich_prometheus'
    scrape_interval: 5s
    static_configs:
      - targets:
        - "immich_server:8081"
        - "immich_server:8082"
